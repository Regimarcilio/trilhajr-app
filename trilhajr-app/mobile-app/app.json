{
  "expo": {
    "name": "RecrutadorNow",
    "slug": "recrutadornow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recrutadornow.app",
      "playRequiresAppStoreAttribution": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.recrutadornow.app",
      "downloadUrl": "https://recrutadornow.com/download"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "recrutadornow-project-id"
      },
      "env": {
        "PAGSEGURO_EMAIL": "",
        "PAGSEGURO_TOKEN": "",
        "PAGSEGURO_MODE": "sandbox",
        "JWT_SECRET": ""
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildProperties": {
              "keystorePropsFile": ".secrets/keystore.properties"
            }
          }
        }
      ]
    ]
  }
}