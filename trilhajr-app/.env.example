# ============================================
# TrilhaJr - Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commit o arquivo .env no repositório!

# API Keys
PAGSEGURO_EMAIL=seu-email@trilhajr.app
PAGSEGURO_TOKEN=seu-token-aqui
PAGSEGURO_MODE=production  # ou sandbox

# Backend
JWT_SECRET=sua-chave-secreta-jwt-minimo-32-caracteres
ASASS_API_KEY=sua-chave-asaas
ASASS_BASE_URL=https://api.asaas.com

# Redis (para rate limiting e cache)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=sua-senha-redis

# OpenAI (para processamento PDF)
OPENAI_API_KEY=seu-api-key-openai

# Armazenamento de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# Ambiente
NODE_ENV=development
PORT=3001

# URLs permitidas (CORS)
ALLOWED_ORIGINS=https://trilhajr.app,https://www.trilhajr.app

# Chave de criptografia para PDFs
PDF_ENCRYPTION_KEY=sua-chave-criptografia-32-chars