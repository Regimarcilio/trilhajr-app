# ─────────────────────────────────────────────────────────────────────────────
# MailChat backend — placeholders de configuração (F0)
# Copie para `.env` (ignorado pelo git). NUNCA versione segredos reais.
# Em produção, injete por secret manager/EnvironmentFile com permissão 0600.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Postgres local do docker-compose.yml (trust auth, somente desenvolvimento).
DATABASE_URL=postgres://mailchat@127.0.0.1:5434/mailchat

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Reservado para F1 (OAuth2/Gmail) — ainda não lido pelo backend F0 ───────
# GOOGLE_CLIENT_ID=<placeholder>
# GOOGLE_CLIENT_SECRET=<placeholder>
# GOOGLE_REDIRECT_URI=<placeholder>
# OAUTH_STATE_SECRET=<placeholder>
# TOKEN_ENCRYPTION_KEY=<placeholder>
# SESSION_SECRET=<placeholder>
