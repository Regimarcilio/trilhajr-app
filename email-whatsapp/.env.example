# ─────────────────────────────────────────────────────────────────────────────
# MailChat — placeholders de configuração
# NUNCA versione segredos reais. Copie para .env/.env.local (ignorado pelo git)
# e injete os valores por secret manager ou EnvironmentFile com permissão 0600.
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API consumida pelo frontend.
# Enquanto o adapter for mock (lib/api/mockApi.ts), esta variável é apenas referência.
# Quando houver API real, ela será lida em runtime pelo adapter.
# ATENÇÃO: variáveis com prefixo NEXT_PUBLIC_ vão para o bundle do navegador.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Google OAuth2 (integração Gmail — ver docs/gmail/) ───────────────────────
# Obtenha em Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.example/api/auth/google/callback

# ── Segredos da aplicação ────────────────────────────────────────────────────
# OAUTH_STATE_SECRET: assina o cookie de state/PKCE (string aleatória longa).
OAUTH_STATE_SECRET=
# TOKEN_ENCRYPTION_KEY: chave AES-256-GCM em base64 (32 bytes). Use KMS/secret manager.
TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET: separado da chave de tokens.
SESSION_SECRET=

# ── Backend e dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://usuario:senha@localhost:5432/mailchat
REDIS_URL=
API_PORT=3000
WEB_ORIGIN=https://seu-dominio.example

# ── Sincronização e observabilidade ──────────────────────────────────────────
# Janela da sincronização inicial, em dias.
SYNC_WINDOW_DAYS=90
LOG_LEVEL=info
