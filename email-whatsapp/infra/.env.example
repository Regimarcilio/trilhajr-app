# ─────────────────────────────────────────────────────────────────────────────
# MailChat — variáveis de interpolação do Docker Compose (produção)
#
# Copie para `infra/.env` com permissão 0600 e preencha no servidor.
# NUNCA versione este arquivo com valores reais.
#
# Uso:
#   install -m 0600 .env.example .env
#   $EDITOR .env
#   docker compose -f compose.prod.yml config
# ─────────────────────────────────────────────────────────────────────────────

# Domínio público (usado pelo proxy e documentação; Nginx usa o valor literal)
MAILCHAT_DOMAIN=mailchat.example.com

# E-mail para o ACME/Let's Encrypt (quando aplicável)
ACME_EMAIL=ops@example.com

# Postgres — superusuário de bootstrap (usado só para init/migrations)
POSTGRES_DB=mailchat
POSTGRES_USER=mailchat_owner
POSTGRES_PASSWORD=__TROQUE_POR_VALOR_ALEATORIO__

# Usuário de aplicação (DML only), criado por postgres/init/10-app-role.sh
# Use uma senha diferente da senha do owner e compatível com URL (A-Z a-z 0-9 _ -).
MAILCHAT_APP_USER=mailchat_app
MAILCHAT_APP_PASSWORD=__TROQUE_POR_VALOR_ALEATORIO_DIFERENTE__

# Imagem/tag do backend (a mesma tag deve ser usada no rollback)
MAILCHAT_IMAGE_TAG=local

# Nível de log do backend: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
