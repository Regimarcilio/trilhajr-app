# ─────────────────────────────────────────────────────────────────────────────
# MailChat backend — EnvironmentFile de produção (modelo)
#
# Destino no servidor:
#   - systemd nativo: /etc/mailchat/backend.env  (0600 root:root)
#   - Compose:        infra/env/backend.env      (0600, dono do deploy)
#
# NUNCA versione este arquivo preenchido. Os valores abaixo são placeholders.
# A validação do backend falha rápido se DATABASE_URL estiver ausente/inválida.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# Loopback no systemd nativo; no Compose o override do compose.prod.yml usa 0.0.0.0.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Usuário de aplicação (DML, sem DDL/superuser). Use host `postgres` no Compose
# e `127.0.0.1`/socket no systemd nativo.
# A senha deve ser URL-safe (A-Z a-z 0-9 _ -) ou percent-encoded.
DATABASE_URL=postgres://mailchat_app:__TROQUE_POR_VALOR_ALEATORIO__@postgres:5432/mailchat

# ── Reservado para F1 (OAuth2/Gmail) ────────────────────────────────────────
# Não são lidos pelo backend F0; mantenha fora do repositório.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://mailchat.example.com/api/auth/google/callback
# OAUTH_STATE_SECRET=
# TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET=
