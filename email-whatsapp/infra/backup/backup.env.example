# ─────────────────────────────────────────────────────────────────────────────
# MailChat — EnvironmentFile do backup (MODELO)
#
# Destino: /etc/mailchat/backup.env  (0600 root:root)
# Não contém senhas: o modo docker usa as variáveis do container Postgres.
# ─────────────────────────────────────────────────────────────────────────────

BACKUP_DIR=/var/backups/mailchat
BACKUP_RETENTION_DAYS=14

# Chave PÚBLICA GPG. A privada fica offline, fora do servidor.
BACKUP_GPG_RECIPIENT=mailchat-backup@example.com

# Compose de produção e serviço do banco.
BACKUP_COMPOSE_FILE=/opt/mailchat/infra/compose.prod.yml
# .env usado só para interpolar o Compose (contém segredos; 0600 root).
BACKUP_COMPOSE_ENV_FILE=/opt/mailchat/infra/.env
BACKUP_DB_SERVICE=postgres
BACKUP_MODE=docker

# node_exporter --collector.textfile.directory=/var/lib/node_exporter/textfile
BACKUP_TEXTFILE_DIR=/var/lib/node_exporter/textfile

# Keyring público do GPG (criado no deploy; ver runbook §6.10).
GNUPGHOME=/var/lib/mailchat-backup/gnupg
